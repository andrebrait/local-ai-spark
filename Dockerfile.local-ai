# Immutable arm64 vLLM 8a728663 base for the Qwen3.8-27B profiles.
ARG BASE_IMAGE=vllm/vllm-openai@sha256:a551e05307cd2e0092139d84db32af9c97e67d2eeeff072d21e429131d8c23f0
FROM ${BASE_IMAGE}
COPY src/patch_prefix_cache.py /tmp/patch_prefix_cache.py
RUN python3 /tmp/patch_prefix_cache.py /usr/local/lib/python3.12/dist-packages \
    && python3 /tmp/patch_prefix_cache.py /usr/local/lib/python3.12/dist-packages \
    && rm /tmp/patch_prefix_cache.py
# vLLM otherwise leaves aliases such as /invocations and diagnostics unguarded.
RUN python3 - <<'PY'
from pathlib import Path
p = Path("/usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/middleware/authenticate.py")
s = p.read_text()
old = 'GUARDED_PREFIX = ("/v1", "/v2", "/inference", "/cohere")'
assert s.count(old) == 1, "Unexpected pinned authentication policy"
s = s.replace(old, 'GUARDED_PREFIX = ("/",)')
s = s.replace("(e.g. /health)", "(all HTTP routes are guarded in this deployment)")
p.write_text(s)
from starlette.responses import JSONResponse
from starlette.testclient import TestClient
from starlette.applications import Starlette
from starlette.routing import Route
namespace = {}
exec(compile(s, str(p), "exec"), namespace)
async def endpoint(request):
    return JSONResponse({"ok": True})
app = Starlette(routes=[Route("/{path:path}", endpoint)])
app.add_middleware(namespace["AuthenticationMiddleware"], tokens=["build-test-token"])
client = TestClient(app)
for route in ("/v1/models", "/invocations", "/tokenize", "/metrics", "/health"):
    assert client.get(route).status_code == 401
    assert client.get(route, headers={"Authorization": "Bearer build-test-token"}).status_code == 200
PY
LABEL local-ai.managed="true" \
      local-ai.model-family="Qwen3.8-27B"
